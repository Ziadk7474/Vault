rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ NO-LOGIN MODE — WIDE OPEN.
    // The app currently has no sign-in step at all, so there is no
    // request.auth to check permissions against. Anyone who has this
    // project's config (which is sitting in the public index.html) and
    // this database's existence can read and write everything below.
    //
    // This is fine for you alone testing on your own device. It is NOT
    // fine once real company documents or other people are involved.
    //
    // The real role-based rules (Owner/Admin/Manager/Member, matching
    // the app's original design) are saved in firestore.rules.role-based.bak
    // in this same folder. When you're ready to turn login back on, ask
    // and this file gets swapped back to that version, paired with
    // re-enabling the sign-in screen in index.html.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
